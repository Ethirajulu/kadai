{
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "./out-tsc/jest",
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["jest", "node"],
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@kadai/*": ["libs/*/src/index.ts"]
    }
  },
  "include": [
    "security-tests/**/*.ts"
  ]
}